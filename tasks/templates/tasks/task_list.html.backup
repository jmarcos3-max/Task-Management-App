<!DOCTYPE html>
<html>
<head>
    <title>Task Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

    <h1>My Tasks</h1>

    <a href="/add/" class="btn btn-primary">Add Task</a>

    <div class="row">
    {% for task in tasks %}
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
<<<<<<< HEAD
    <div class="dropdown float-end">
        <button class="btn btn-light" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Task options">
            &#8942;
        </button>

        <ul class="dropdown-menu">
            <li>
                <a class="dropdown-item" href="{% url 'edit_task' task.id %}">Edit</a>
            </li>
        </ul>
    </div>

    
    <h5 class="card-title">{{ task.title }}</h5>
<p class="card-text">{{ task.description }}</p>
<p class="card-text">Due: {{ task.due_date }}</p>
<p class="card-text">Priority: {{ task.priority }}</p>
</div>
